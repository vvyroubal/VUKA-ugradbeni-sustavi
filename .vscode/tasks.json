{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Izgradnja i QEMU / Build and run in QEMU",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/vscode-task.sh",
        "build-qemu",
        "${input:lab}"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\vscode-task.ps1",
          "build-qemu",
          "${input:lab}"
        ]
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Izgradnja / Build",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/vscode-task.sh",
        "build",
        "${input:lab}"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\vscode-task.ps1",
          "build",
          "${input:lab}"
        ]
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "QEMU (zadnja izgradnja / latest build)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/vscode-task.sh",
        "qemu",
        "${input:lab}"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\vscode-task.ps1",
          "qemu",
          "${input:lab}"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "QEMU za GDB, čeka debugger / QEMU for GDB, waits for the debugger",
      "detail": "zadnja izgradnja odabrane vježbe / latest build of the chosen lab",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/vscode-task.sh",
        "gdb",
        "${input:lab}"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\vscode-task.ps1",
          "gdb",
          "${input:lab}"
        ]
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$gcc",
        "background": {
          "activeBegins": true,
          "beginsPattern": "^== ",
          "endsPattern": "gdbstub on :1234"
        }
      }
    },
    {
      "label": "LV7: izgradnja Buildroota / Buildroot build",
