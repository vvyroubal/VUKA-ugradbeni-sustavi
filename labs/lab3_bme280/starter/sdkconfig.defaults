CONFIG_IDF_TARGET="esp32c3"

# Lab 3 always runs its own driver, main/bme280_i2c.c -- never the
# synthetic bme280_sim of Labs 5 and 6.
# CONFIG_LAB_SIM_BME280 is not set

# QEMU (build/): the driver talks to the simulated registers of
# component bme280_regsim. The board variant (build-hw/) turns this
# off with sdkconfig.hw.
CONFIG_LAB3_REG_SIM=y
